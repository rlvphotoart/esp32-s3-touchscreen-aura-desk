# Only explicitly selected synthetic offline UI previews are public samples.
*.png
/artifacts/*
!/artifacts/ui-preview/
/artifacts/ui-preview/*
!/artifacts/ui-preview/home_offline.png
!/artifacts/ui-preview/settings_offline.png
!/artifacts/ui-preview/settings_always_on_offline.png
!/artifacts/ui-preview/weather_offline.png
!/artifacts/ui-preview/tools_offline.png
*.raw
